<div class="footer-container">
  <footer class="footer">
    <ul class="footer-links">
      <li>
        <a href="https://codeberg.org/tysufa">
          <img
            width="24"
            height="24"
            src='{{ "codeberg" |> icon("simpleicons") }}'
            inline
          >
          Codeberg
        </a>
      </li>
      <li>
        <a rel="me" href="https://github.com/tysufa">
          <img
            width="24"
            height="24"
            src='{{ "github" |> icon("simpleicons") }}'
            inline
          >
          GitHub
        </a>
      </li>
      <li>
        <a rel="me" href="https://fosstodon.org/@lume">
          <img
            width="24"
            height="24"
            src='{{ "mastodon" |> icon("simpleicons") }}'
            inline
          >
          Mastodon
        </a>
      </li>
      <li>
        <a href="https://bsky.app/profile/lume.land">
          <img
            width="24"
            height="24"
            src='{{ "bluesky" |> icon("simpleicons") }}'
            inline
          >
          BlueSky
        </a>
      </li>
    </ul>
    <p class="footer-copyright">
      Based <b> heavely </b> on <a href="https://github.com/lumeland/lume.land">lume.land</a> made by <a href="https://oscarotero.com/">Óscar Otero</a>
      — <button
        class="button-theme"
        id="switch-theme"
        title="Toggle light & dark theme"
        aria-label="auto"
        aria-live="polite"
      >
        <span class="is-light">Dark theme</span>
        <span class="is-dark">Light theme</span>
      </button>
    </p>
  </footer>
</div>
